datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Platform ────────────────────────────────────────────

model SuperAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notifications Notification[]
}

// ─── Organisation ────────────────────────────────────────

enum OrgPlan {
  BASIC
  ADVANCED
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

model Organisation {
  id        String    @id @default(uuid())
  name      String
  tradingName String?
  tagline   String?
  timezone  String
  email     String
  phone     String?
  brandColor String  @default("#0f766e")
  logoKey   String?
  logoMimeType String?
  logoFileName String?
  plan      OrgPlan
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users                 User[]
  organisationModules   OrganisationModule[]
  onboardingSubmissions OnboardingSubmission[]
  customers             Customer[]
  crmOpportunities      CrmOpportunity[]
  shiftSeries           ShiftSeries[]
  shifts                Shift[]
  workerAvailabilities  WorkerAvailability[]
  availabilityExceptions AvailabilityException[]
  serviceLineTaskTemplates ServiceLineTaskTemplate[]
}

// ─── User (organisation-scoped) ──────────────────────────

enum UserRole {
  ORG_ADMIN
  MANAGER
  ROSTERING_EXPERT
  EMPLOYEE
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

// Product onboarding lifecycle (separate from account UserStatus).
enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  PENDING_REVIEW
  VERIFIED
  CHANGES_REQUIRED
}

model User {
  id                    String           @id @default(uuid())
  organisationId        String
  firstName             String
  lastName              String
  email                 String           @unique
  passwordHash          String?
  role                  UserRole
  status                UserStatus       @default(INVITED)
  // Org Admin must be approved by Super Admin after password setup.
  // Workforce users stay true (default) and are unaffected.
  platformApproved      Boolean          @default(true)
  onboardingStatus      OnboardingStatus @default(NOT_STARTED)
  onboardingCompletedAt DateTime?
  setupTokenHash        String?
  setupTokenExpiresAt   DateTime?
  passwordResetOtpHash  String?
  passwordResetExpiresAt DateTime?
  passwordResetAttempts Int              @default(0)
  emailVerifiedAt       DateTime?
  lastLoginAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organisation           Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  onboardingSubmission   OnboardingSubmission?
  reviewedOnboardings    OnboardingSubmission[] @relation("OnboardingReviews")
  createdCustomers       Customer[]             @relation("CustomerCreatedBy")
  uploadedCustomerDocs   CustomerDocument[]     @relation("CustomerDocUploadedBy")
  ownedOpportunities     CrmOpportunity[]       @relation("OpportunityOwner")
  // Rostering: shifts this worker was offered or accepted.
  offeredShifts          Shift[]                @relation("ShiftOfferedTo")
  assignedShifts         Shift[]                @relation("ShiftAssignedTo")
  createdShifts          Shift[]                @relation("ShiftCreatedBy")
  reviewedShifts         Shift[]                @relation("ShiftReviewedBy")
  weeklyAvailability     WorkerAvailability[]
  availabilityExceptions AvailabilityException[]
  notifications          Notification[]

  @@index([organisationId])
}

// ─── Workforce onboarding (one submission per user) ───────

model OnboardingSubmission {
  id             String           @id @default(uuid())
  userId         String           @unique
  organisationId String
  roleSnapshot   UserRole
  currentStep    Int              @default(0)
  payload        Json             @default("{}")
  status         OnboardingStatus @default(IN_PROGRESS)
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewedById   String?
  reviewNote     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  reviewedBy   User?                @relation("OnboardingReviews", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents    OnboardingDocument[]

  @@index([organisationId])
  @@index([organisationId, status])
}

model OnboardingDocument {
  id           String   @id @default(uuid())
  submissionId String
  fieldKey     String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  uploadedAt   DateTime @default(now())

  submission OnboardingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, fieldKey])
  @@index([submissionId])
}

// ─── Customers (participants) — master data, no login ────

enum CustomerStatus {
  ONBOARDING
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CustomerDocumentKind {
  MANDATORY
  OPTIONAL
}

model Customer {
  id                     String         @id @default(uuid())
  organisationId         String
  firstName              String
  middleName             String?
  preferredName          String?
  surname                String
  email                  String?
  phone                  String?
  dateOfBirth            DateTime?
  address                String?
  // Display name only — does not drive templates or checklists.
  serviceLine            String         @default("")
  planStartDate          DateTime?
  planEndDate            DateTime?
  status                 CustomerStatus @default(ONBOARDING)
  supportSummary         String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  goals                  String?
  risks                  String?
  createdById            String
  // Set when this customer was created from a CRM opportunity.
  sourceOpportunityId    String?        @unique
  activatedAt            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  organisation      Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy         User              @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  sourceOpportunity CrmOpportunity?   @relation("OpportunityConvertedCustomer", fields: [sourceOpportunityId], references: [id], onDelete: SetNull)
  documents         CustomerDocument[]
  shifts            Shift[]

  @@index([organisationId])
  @@index([organisationId, status])
}

model CustomerDocument {
  id           String               @id @default(uuid())
  customerId   String
  kind         CustomerDocumentKind
  // Fixed key for mandatory slots (e.g. ID_CARD); free label key for optional.
  fieldKey     String
  label        String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  uploadedById String
  uploadedAt   DateTime             @default(now())

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("CustomerDocUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@unique([customerId, fieldKey])
  @@index([customerId])
}

// ─── CRM opportunities (pipeline) ────────────────────────

enum OpportunityStage {
  ENQUIRY
  QUALIFIED
  PROPOSAL
  ACCEPTED
  LOST
}

model CrmOpportunity {
  id                    String           @id @default(uuid())
  organisationId        String
  title                 String
  serviceLine           String           @default("")
  ownerId               String
  contactName           String?
  contactEmail          String?
  contactPhone          String?
  stage                 OpportunityStage @default(ENQUIRY)
  // Estimated annual value — not actual revenue.
  estimatedAnnualValue  Float?
  nextFollowUpAt        DateTime?
  followUpNote          String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organisation       Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  owner              User         @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  convertedCustomer  Customer?    @relation("OpportunityConvertedCustomer")

  @@index([organisationId])
  @@index([organisationId, stage])
}

// ─── Modules ─────────────────────────────────────────────

model Module {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String   @default("")
  isCore      Boolean  @default(false)
  createdAt   DateTime @default(now())

  organisationModules OrganisationModule[]
}

model OrganisationModule {
  id             String   @id @default(uuid())
  organisationId String
  moduleId       String
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  module       Module       @relation(fields: [moduleId], references: [id])

  @@unique([organisationId, moduleId])
  @@index([organisationId])
}

// ─── Rostering / SCHEDULE + SERVICE_DELIVERY ──────────────
// Phase A: Draft → publish/offer → accept/decline
// Phase B: Start → tasks/note → finish (±15 min auto-approve or Org Admin)

enum ShiftStatus {
  DRAFT
  UNFILLED
  OFFERED
  ACCEPTED
  IN_PROGRESS
  // Outside ±15 minute margin — waiting for Org Admin.
  PENDING_APPROVAL
  // Auto-approved (within margin) or Org Admin approved.
  APPROVED
  // Org Admin rejected the submitted variance.
  REJECTED
  CANCELLED
}

enum ShiftLocationKind {
  PARTICIPANT
  SITE
  OTHER
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
}

// Org catalogue of required tasks for a service line (v1 — no customer extras).
model ServiceLineTaskTemplate {
  id             String   @id @default(uuid())
  organisationId String
  serviceLine    String
  label          String
  sortOrder      Int      @default(0)
  required       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, serviceLine, label])
  @@index([organisationId, serviceLine])
}

// Linked group created when Rostering Expert saves a recurring pattern.
model ShiftSeries {
  id             String              @id @default(uuid())
  organisationId String
  frequency      RecurrenceFrequency
  interval       Int                 @default(1)
  // Inclusive end date of the generated window (date-only stored as UTC midnight).
  untilDate      DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  shifts       Shift[]

  @@index([organisationId])
}

model Shift {
  id               String            @id @default(uuid())
  organisationId   String
  seriesId         String?
  // Optional link to a Customer when location is participant-based (or always for care).
  customerId       String?
  locationKind     ShiftLocationKind
  // Free-text site / other location (v1 — no Site entity yet).
  locationLabel    String
  participantName  String
  serviceLine      String
  serviceTitle     String
  // Calendar date of the shift (UTC midnight).
  date             DateTime
  startTime        String
  endTime          String
  // Stored in 5-minute increments.
  durationMinutes  Int
  status           ShiftStatus       @default(DRAFT)
  // Rostering planning note (set at create/edit).
  notes            String?
  // Employee progress note — only writable while IN_PROGRESS.
  progressNote     String?
  offeredWorkerId  String?
  assignedWorkerId String?
  createdById      String
  publishedAt      DateTime?
  // Phase B execution times (server clock).
  actualStartedAt  DateTime?
  actualEndedAt    DateTime?
  // Signed minutes vs scheduled end (negative = finished early).
  endVarianceMinutes Int?
  // Signed minutes vs scheduled start (negative = started early).
  startVarianceMinutes Int?
  // Required when start or end variance is outside ±15 minutes.
  finishReason     String?
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  series         ShiftSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  offeredWorker  User?        @relation("ShiftOfferedTo", fields: [offeredWorkerId], references: [id], onDelete: SetNull)
  assignedWorker User?        @relation("ShiftAssignedTo", fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  createdBy      User         @relation("ShiftCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  reviewedBy     User?        @relation("ShiftReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  tasks          ShiftTask[]

  @@index([organisationId, date])
  @@index([organisationId, status])
  @@index([offeredWorkerId])
  @@index([assignedWorkerId])
  @@index([customerId])
  @@index([seriesId])
}

// Snapshot of required tasks copied from the service-line catalogue at create time.
model ShiftTask {
  id          String    @id @default(uuid())
  shiftId     String
  label       String
  sortOrder   Int       @default(0)
  required    Boolean   @default(true)
  completedAt DateTime?

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
}

// Recurring weekly availability for an employee (Mon=1 … Sun=7).
model WorkerAvailability {
  id             String @id @default(uuid())
  organisationId String
  userId         String
  // ISO weekday: 1 = Monday … 7 = Sunday.
  dayOfWeek      Int
  enabled        Boolean @default(true)
  startTime      String  @default("07:00")
  endTime        String  @default("19:00")
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek])
  @@index([organisationId])
}

// One-off unavailable date ranges that override the weekly pattern.
model AvailabilityException {
  id             String   @id @default(uuid())
  organisationId String
  userId         String
  fromDate       DateTime
  toDate         DateTime
  reason         String   @default("")
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([userId, fromDate, toDate])
}

// ─── Platform settings ───────────────────────────────────
// Single-row table for Super Admin platform switches.

model PlatformSetting {
  id              String   @id @default("default")
  maintenanceMode Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

// ─── Platform audit log ──────────────────────────────────
// Records Super Admin actions such as registering an org.

model AuditLog {
  id               String   @id @default(uuid())
  action           String
  actorEmail       String
  organisationName String?
  details          String   @default("")
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

// ─── Demo requests (public Book a Demo form) ─────────────

enum DemoRequestStatus {
  PENDING
  CONTACTED
  COMPLETED
}

model DemoRequest {
  id               String            @id @default(uuid())
  organisationName String
  contactName      String
  email            String
  phone            String?
  numberOfUsers    Int?
  preferredDate    DateTime
  preferredTime    String
  message          String            @default("")
  status           DemoRequestStatus @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ─── In-app notifications ────────────────────────────────
// Simple, single-table notification feed. Each row belongs to exactly one
// recipient — either an organisation user (userId) or a Super Admin
// (superAdminId). No queues/events framework — services just call
// NotificationsService.notify*() directly after the action that matters.

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Notification {
  id             String            @id @default(uuid())
  // Exactly one of these two is set, depending on recipient kind.
  userId         String?
  superAdminId   String?
  // Denormalised for cheap org-scoped queries/cleanup; not a strict FK need.
  organisationId String?
  type           NotificationType  @default(INFO)
  title          String
  message        String
  // Optional client-side deep link, e.g. "/manager/schedule/shifts/<id>".
  link           String?
  isRead         Boolean           @default(false)
  readAt         DateTime?
  createdAt      DateTime          @default(now())

  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  superAdmin SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([superAdminId, isRead, createdAt])
}
