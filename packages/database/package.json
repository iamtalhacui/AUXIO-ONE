{
  "name": "@repo/database",
  "version": "1.0.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "prisma generate",
    "db:dedupe-emails": "tsx prisma/dedupe-user-emails.ts",
    "db:push": "prisma db push --accept-data-loss",
    "db:setup": "pnpm db:dedupe-emails && pnpm db:push && pnpm db:generate && pnpm db:seed",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.19.43",
    "prisma": "6.19.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3"
  }
}
