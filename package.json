{
  "name": "auxio-one",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:client": "turbo run dev --filter=client",
    "dev:server": "turbo run dev --filter=server",
    "build": "turbo run build",
    "build:client": "turbo run build --filter=client",
    "build:server": "turbo run build --filter=server",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter database exec prisma generate",
    "db:push": "pnpm --filter database exec prisma db push",
    "db:build": "pnpm --filter database build",
    "db:seed": "pnpm --filter database db:seed",
    "db:setup": "pnpm db:push && pnpm db:generate && pnpm db:build && pnpm db:seed",
    "server:dev": "pnpm db:build && pnpm --filter server dev"
  },
  "packageManager": "pnpm@11.24.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "turbo": "^2.10.11"
  }
}
